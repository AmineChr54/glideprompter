{
  "name": "glideprompter",
  "version": "1.3.0",
  "description": "Smooth two-window teleprompter for live talks and OBS",
  "main": "main.js",
  "author": "Amine Cheikhrouhou",
  "license": "MIT",
  "repository": "github:AmineChr54/glideprompter",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:mac": "electron-builder --mac zip --arm64 --x64",
    "web": "node tools/build-web.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "sherpa-onnx-node": "^2.0.2"
  },
  "productName": "GlidePrompter",
  "build": {
    "appId": "io.github.aminechr54.glideprompter",
    "productName": "GlidePrompter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "output.html",
      "output.css",
      "output.js",
      "control.html",
      "control.css",
      "control.js",
      "shared/**",
      "follow/**",
      "build/icon.png",
      "default-scripts/**",
      "package.json"
    ],
    "electronLanguages": [
      "en-US",
      "de"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "GlidePrompter.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Smooth two-window teleprompter",
      "maintainer": "AmineChr54 <AmineChr54@users.noreply.github.com>",
      "executableName": "glideprompter"
    },
    "appImage": {
      "artifactName": "GlidePrompter-linux-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "GlidePrompter-linux-amd64.deb"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "GlidePrompter-mac-${arch}.zip",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Follow mode listens to the speaker so the script can scroll with their voice. Audio stays on this Mac."
      }
    }
  }
}
